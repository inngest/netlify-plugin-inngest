{
  "name": "netlify-plugin-inngest",
  "version": "1.0.0",
  "description": "Netlify Build plugin - A Netlify build plugin for creating Inngest functions.",
  "type": "module",
  "exports": "./src/index.js",
  "main": "./src/index.js",
  "files": [
    "src/**/*.js",
    "src/**/*.json",
    "src/**/*.sh",
    "src/**/*.html",
    "src/**/*.ejs",
    "manifest.yml"
  ],
  "keywords": [
    "netlify-plugin",
    "netlify"
  ],
  "author": "Inngest <1736957+jpwilliams@users.noreply.github.com>",
  "license": "MIT",
  "repository": "github:inngest/netlify-plugin-inngest",
  "bugs": {
    "url": "https://github.com/inngest/netlify-plugin-inngest/issues",
    "email": "security@inngest.com"
  },
  "directories": {
    "lib": "src"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "netlify-build",
    "test": "npm run lint",
    "lint": "npm run eslint && npm run prettier",
    "eslint": "eslint --cache --max-warnings=0 \"{src,init}/**/*.{cjs,mjs,js}\"",
    "prettier": "prettier --ignore-path .gitignore --write --log-level warn \"{.github,src,init}/**/*.{cjs,mjs,js,md,yml,json}\" \"*.{cjs,mjs,js,md,yml,json}\"",
    "release": "release-it"
  },
  "devDependencies": {
    "@netlify/build": "^35.13.6",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^18.0.1",
    "eslint-plugin-prettier": "^5.5.5",
    "execa": "^9.6.1",
    "netlify-cli": "^27.0.1",
    "prettier": "^3.8.3",
    "release-it": "^20.0.1"
  }
}
